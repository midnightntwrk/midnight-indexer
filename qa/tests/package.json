{
  "name": "midnight-indexer-viteset",
  "scripts": {
    "format": "prettier --write '**/*.{js,jsx,json,ts,tsx,graphql,gql}' '!.tmp/**'",
    "format:check": "prettier --check '**/*.{js,jsx,json,ts,tsx,graphql,gql}' '!.tmp/**'",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --fix",
    "audit": "bun audit --audit-level=high",
    "compile-check": "tsc --noEmit",
    "test": "vitest run --project smoke --project e2e --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:smoke": "vitest run --project smoke",
    "test:integration": "vitest run --project integration",
    "test:sync": "vitest run --project sync",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest --ui --project smoke --project e2e --project integration",
    "test:coverage": "vitest run --coverage --project smoke --project e2e --project integration",
    "coverage:generate": "bun ./coverage/src/cli.ts generate",
    "coverage:check": "bun ./coverage/src/cli.ts check",
    "coverage:all": "bun run coverage:generate && bun run coverage:check",
    "clean:logs": "rm -rf logs/",
    "clean:reports": "rm -rf reports/",
    "clean:modules": "rm -rf node_modules/",
    "clean": "bun run clean:logs && bun run clean:reports && bun run clean:modules",
    "prepare": "cd ../.. && husky qa/tests/.husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,graphql,gql}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnightntwrk/wallet-sdk": "^1.2.0",
    "@shieldedtech/moth-wallet": "0.13.1-canary.20260917165053-023b847",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@graphql-inspector/core": "^6.4.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "bech32": "^2.0.0",
    "diff": "^8.0.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "graphql": "^16.11.0",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.1.0",
    "husky": "^9.1.7",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^15.5.2",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3.25.76"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@scure/base": "2.3.0"
  }
}
